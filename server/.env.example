# Base de datos (servidor Postgres aparte). Usar sslmode=require si la conexión
# entre servidores pasa por una red compartida.
DATABASE_URL=postgres://usuario:contraseña@host-postgres:5432/votokiosco

# Dirección donde escucha el server. En producción, detrás de IIS, usar
# 127.0.0.1 para que solo IIS pueda llegar a él (elegir un puerto libre).
BIND_ADDR=0.0.0.0:3000

# Orígenes de navegador permitidos (CORS), separados por coma. En producción
# el panel está en el mismo dominio que la API: dejar vacío.
# En desarrollo: http://localhost:5173
CORS_ORIGINS=

# Carpeta donde se guardan las fotos de los kioskos (obligatoria).
# En producción usar ruta absoluta FUERA de las carpetas de IIS, p. ej.
# PHOTOS_DIR='E:\FotoKiosco'   (rutas con \ entre comillas simples; sin comillas falla)
PHOTOS_DIR=uploads
# Fotos más viejas que esto se borran automáticamente (una vez al día).
PHOTO_RETENTION_DAYS=90

# Autenticación del panel admin
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=cambia-esta-contraseña

# Clave compartida que usa el kiosko para poder votar sin login de usuario
KIOSK_API_KEY=cambia-esto-por-otra-cadena-larga-y-aleatoria
